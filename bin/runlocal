#!/bin/bash

# Wrapper for utils/runlocal.py: run cnf jobs locally, several at a time.
# Outputs stay on local disk; nothing is pushed or declared to SAM.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PYTHON_SCRIPT="$SCRIPT_DIR/../utils/runlocal.py"

if [[ "$1" == "--help" ]] || [[ "$1" == "-h" ]]; then
    exec python3 "$PYTHON_SCRIPT" "$@"
fi

# mdh for the tarball/input fetch; each job sources its own SimJob setup.
# Child jobs inherit this environment.
source /cvmfs/mu2e.opensciencegrid.org/setupmu2e-art.sh
muse setup ops

exec python3 "$PYTHON_SCRIPT" "$@"
