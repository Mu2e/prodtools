#!/bin/bash

# Shell wrapper for json2jobdef.py: checks the Mu2e env, then execs the script.

# --help/-h: pass through to Python for full help
if [[ "$1" == "--help" ]] || [[ "$1" == "-h" ]]; then
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    PYTHON_SCRIPT="$SCRIPT_DIR/../utils/json2jobdef.py"
    
    if [[ ! -f "$PYTHON_SCRIPT" ]]; then
        echo "Error: Python script not found at $PYTHON_SCRIPT"
        exit 1
    fi
    
    exec python3 "$PYTHON_SCRIPT" "$@"
fi

if [[ $# -eq 0 ]]; then
    echo "Usage: json2jobdef [options]"
    echo "  --json <json_file>     Path to JSON configuration file (required)"
    echo "  --index <n>            Index of configuration to process"
    echo "  --desc <desc>          Dataset descriptor (with --dsconf)"
    echo "  --dsconf <dsconf>      Dataset configuration"
    echo "  --verbose              Enable verbose output"
    echo "  --no-cleanup           Keep temporary files"
    echo "  --pushout              Enable SAM pushOutput"
    echo "  --prod                 Production mode; requires --enqueue"
    echo "  --enqueue              Register a sliced-submission campaign in the ledger"
    echo "  --slice-size <n>       Jobs per slice for --enqueue (default 1000)"
    echo ""
    echo "Example:"
    echo "  json2jobdef --json config.json --index 0"
    echo "  json2jobdef --json mix.json --dsconf MDC2020ba_best_v1_3"
    echo "  json2jobdef --json data/stage1.json --desc X --dsconf Y --prod --enqueue"
    echo ""
    echo "For complete help with all options, use: json2jobdef --help"
    exit 1
fi

if [[ -z "$MUSE_DIR" ]] || ! command -v mu2e >/dev/null 2>&1; then
    echo "Error: Mu2e environment not set up. Run: muse setup ops, then muse setup SimJob <tag> (or source a Musing setup.sh)"
    exit 1
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PYTHON_SCRIPT="$SCRIPT_DIR/../utils/json2jobdef.py"

if [[ ! -f "$PYTHON_SCRIPT" ]]; then
    echo "Error: Python script not found at $PYTHON_SCRIPT"
    exit 1
fi

exec python3 "$PYTHON_SCRIPT" "$@"
