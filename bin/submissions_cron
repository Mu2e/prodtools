#!/bin/bash
# Cron entry point for the direct-submission maintenance tick. Install
# in mu2epro's crontab (hourly), e.g.:
#   17 * * * * /path/to/prodtools/bin/submissions_cron
#
# Order matters:
#   1. locking — handled inside `submissions run` (a per-DB lockfile
#      beside the DB, held for the process lifetime); an overlapping
#      run exits 1 rather than double-submitting.
#   2. Mu2e env (quiet; failures still surface via the python run)
#   3. submissions run, appended to a dated log beside the DB
#
# Deliberately NO token pre-check: mu2epro's hourly cron/tokens.sh
# stores its bearer token as /tmp/bt_token_mu2e_production_<uid>
# (jobsub_lite's naming), none of the three places `httokendecode`
# looks by default ($BEARER_TOKEN_FILE, $XDG_RUNTIME_DIR/bt_u<uid>,
# /tmp/bt_u<uid>). A gate on it would fail while a valid token is
# present, and under `set -e` silently no-op every tick. Submitting
# steps authenticate for themselves and fail loudly instead.
# NEVER fetch or refresh a token here: report, don't remediate.
set -e

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DB="${MU2E_SUBMISSION_DB:-/exp/mu2e/data/users/mu2epro/prodtools/submissions.db}"
DBDIR="$(dirname "$DB")"
LOG="$DBDIR/submissions-$(date +%Y%m%d).log"

{
    echo "=== submissions_cron $(date -u +%FT%TZ) ==="
    source /cvmfs/mu2e.opensciencegrid.org/setupmu2e-art.sh >/dev/null 2>&1 || true
    muse setup ops >/dev/null 2>&1 || true
    python3 "$REPO/utils/submissions.py" --db "$DB" run
} >>"$LOG" 2>&1
